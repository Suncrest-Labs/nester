NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_STELLAR_NETWORK=Test SDF Network ; September 2015
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_VAULT_CONTRACT_ADDRESS=C... # Deployed vault contract address
NEXT_PUBLIC_VAULT_TOKEN_CONTRACT_ADDRESS=C... # Deployed vault token contract address
NEXT_PUBLIC_EXPLORER_URL=https://stellar.expert/explorer/testnet
NEXT_PUBLIC_DEFAULT_NGN_RATE=1530
NEXT_PUBLIC_FRIENDBOT_URL=https://friendbot.stellar.org
NEXT_PUBLIC_FEATURED_WALLETS=freighter,lobstr,xbull

# Vault Factory Configuration
# The Soroban network to use for vault creation
# Options: "testnet" or "mainnet"
NEXT_PUBLIC_NETWORK=testnet

# Deployed vault factory contract ID on Soroban
# Format: C followed by 55 alphanumeric characters
# Testnet factory contract: (deployed factory contract ID on testnet)
# Mainnet factory contract: (deployed factory contract ID on mainnet)
NEXT_PUBLIC_VAULT_FACTORY_CONTRACT_ID=C...

# E2E Testing Configuration
# Funded testnet account secret key for E2E tests ONLY
# This account is used exclusively in automated E2E tests to deploy vaults
# Never expose this key in production or on public networks
# Generate a new funded testnet account at: https://friendbot.stellar.org
E2E_TESTNET_SECRET_KEY=S...

# Mainnet-style signer configuration fixture for TestMainnetPolicyFixture.
# Mirrors the keys used by docker-compose.signer.yml / deploy/mainnet so the
# policy is exercised against the same shape of configuration a production
# signer loads. Values are placeholders (no real secret or contract address).
STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
STELLAR_RPC_URL=https://soroban-rpc.mainnet.stellar.org
STELLAR_HORIZON_URL=https://horizon.stellar.org
STELLAR_OPERATOR_SECRET=SAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
SIGNER_SOCKET_PATH=/tmp/nester-signer.sock
SIGNER_KILL_SWITCH_PATH=/tmp/nester-signing.disabled
SIGNER_ALLOWED_CONTRACTS=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
SIGNER_ALLOWED_OPERATIONS=deposit
SIGNER_MAX_AMOUNT_STROOPS=1000000000
SIGNER_MAX_INTENT_AGE=2m
SIGNER_CLOCK_SKEW=30s